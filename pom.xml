<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.5</version> <!-- Актуальная и стабильная версия Spring Boot 3 -->
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- Координаты твоего проекта -->
	<groupId>com.atta.PolyPaste</groupId>
	<artifactId>moderation-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>PolyPaste Moderation Service</name>
	<description>ML Moderation microservice using ONNX and RabbitMQ</description>

	<properties>
		<java.version>17</java.version>
		<onnxruntime.version>1.17.1</onnxruntime.version>
	</properties>

	<dependencies>
		<!-- Базовый стартер Spring Boot (включает Jackson для JSON и логирование Slf4j/Logback) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<!-- Spring AMQP: Предоставляет RabbitTemplate и @RabbitListener -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>
		<!-- Добавь этот стартер для поддержки JSON (Jackson) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-json</artifactId>
		</dependency>

		<!-- ONNX Runtime: Движок для запуска локальной модели rubert-tiny-toxic -->
		<dependency>
			<groupId>com.microsoft.onnxruntime</groupId>
			<artifactId>onnxruntime</artifactId>
			<version>${onnxruntime.version}</version>
		</dependency>

		<!-- Lombok: Убирает бойлерплейт-код (@Data, @Slf4j, @RequiredArgsConstructor) -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- ================= ТЕСТИРОВАНИЕ ================= -->
		<!-- Spring Boot Test (JUnit 5, Mockito) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Утилиты для мока и тестирования RabbitMQ -->
		<dependency>
			<groupId>org.springframework.amqp</groupId>
			<artifactId>spring-rabbit-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>ai.djl.huggingface</groupId>
			<artifactId>tokenizers</artifactId>
			<version>0.29.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Плагин для сборки толстого JAR (Fat JAR), необходимого для деплоя в Docker -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<!-- Lombok не нужен в финальном скомпилированном JAR файле -->
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>